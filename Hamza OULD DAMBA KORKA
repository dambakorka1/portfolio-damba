<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#090A0D;--s1:#101216;--s2:#15171C;--line:#24272E;--tx:#F3F2EE;--mu:#9B9DA4;--ac:#D9FF62;
--f:"Inter Tight",Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--pad:clamp(1.25rem,4vw,3.5rem)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:4rem}
body{background:var(--bg);color:var(--tx);font-family:var(--f);line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{display:block;width:100%;height:100%;object-fit:cover}
:focus-visible{outline:2px solid var(--ac);outline-offset:3px}
.wrap{max-width:1440px;margin:0 auto;padding:0 var(--pad)}
.lab{font-size:.78rem;color:var(--mu);letter-spacing:.02em}
.ac{color:var(--ac)}

/* nav */
nav{position:fixed;inset:0 0 auto 0;z-index:10;background:rgba(9,10,13,.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;justify-content:space-between;align-items:center;height:3.5rem}
nav b{font-weight:500;font-size:.85rem}
nav ul{display:flex;gap:1.75rem;list-style:none}
.ul{position:relative;font-size:.85rem;color:var(--mu);transition:color .25s}
.ul::after{content:"";position:absolute;left:0;bottom:-3px;height:1px;width:100%;background:var(--ac);transform:scaleX(0);transform-origin:left;transition:transform .3s}
.ul:hover{color:var(--tx)}.ul:hover::after{transform:scaleX(1)}

/* hero */
.hero{min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding:7rem 0 3rem;border-bottom:1px solid var(--line)}
h1{font-weight:600;font-size:clamp(2.6rem,12.2vw,10.5rem);line-height:.86;letter-spacing:-.05em}
h1 span{display:block}
.hero .role{margin-top:clamp(2rem,5vw,4rem);display:flex;flex-wrap:wrap;justify-content:space-between;gap:1.25rem 3rem;border-top:1px solid var(--line);padding-top:1.5rem}
.role p:first-child{font-size:clamp(1.1rem,2.2vw,1.6rem);font-weight:500;letter-spacing:-.02em}
.role div:last-child{text-align:right}
.hero h1,.hero .role{animation:rise 1s cubic-bezier(.2,.7,.2,1) both}
.hero .role{animation-delay:.25s}
@keyframes rise{from{opacity:0;transform:translateY(24px)}}

/* sections */
section{padding:clamp(4rem,9vw,8rem) 0}
.sh{display:flex;align-items:baseline;gap:1.25rem;margin-bottom:clamp(2rem,4vw,3.5rem)}
.sh h2{font-weight:600;font-size:clamp(1.8rem,4.5vw,3.6rem);letter-spacing:-.04em;line-height:1}
.sh .lab{margin-left:auto}
.cat{border-top:1px solid var(--line);padding-top:1.5rem;margin-bottom:clamp(4rem,8vw,7rem)}
.cat>header{display:flex;align-items:baseline;gap:1rem;margin-bottom:2rem}
.cat h3{font-weight:500;font-size:clamp(1.3rem,2.6vw,2rem);letter-spacing:-.03em}
.cat header .lab{margin-left:auto}

.v{position:relative;aspect-ratio:16/9;background:var(--s1);border:1px solid var(--line);transition:border-color .3s,transform .4s}
.v.p{aspect-ratio:9/16}
.v:hover{border-color:var(--ac);transform:scale(1.008)}
a.v{display:block;overflow:hidden}
.v img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.v::after{content:"";position:absolute;inset:0;background:rgba(9,10,13,.28);transition:background .3s}
.v:hover::after{background:rgba(9,10,13,.1)}
.play{position:absolute;z-index:1;left:50%;top:50%;width:4.25rem;height:4.25rem;margin:-2.125rem 0 0 -2.125rem;border:1px solid var(--tx);border-radius:50%;background:rgba(9,10,13,.55);transition:border-color .3s,background .3s}
.play::before{content:"";position:absolute;left:50%;top:50%;width:1.1rem;height:1.25rem;margin:-.625rem 0 0 -.4rem;background:var(--tx);clip-path:polygon(0 0,100% 50%,0 100%);transition:background .3s}
.v:hover .play,.v:focus-visible .play{border-color:var(--ac)}
.v:hover .play::before,.v:focus-visible .play::before{background:var(--ac)}
.yt{display:inline-block;margin-top:.5rem;font-size:.78rem}
.cap{display:flex;gap:.9rem;align-items:baseline;margin-top:1rem}
.cap .n{font-size:.78rem;color:var(--ac);min-width:1.6rem}
.cap h4{font-weight:500;font-size:1.1rem;letter-spacing:-.015em;line-height:1.3}
.cap .lab{display:block;margin-top:.15rem}
[lang=ar]{direction:rtl;unicode-bidi:isolate;display:inline-block;font-size:1.25em}

/* broadcast */
.bc{display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(1.25rem,2.5vw,2.5rem)}
.bc>.a{grid-column:1/9}
.bc>.a+.cap-side{grid-column:9/13;align-self:end}
.bc>.b{grid-column:span 6}
.cap-side h4{font-weight:600;font-size:clamp(1.5rem,2.6vw,2.3rem);letter-spacing:-.03em;line-height:1.2;margin:.5rem 0}
/* events */
.ev{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.25rem,3vw,3rem)}
.ev>div:last-child{margin-top:clamp(2rem,8vw,7rem)}
/* social */
.so{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,3vw,3rem);align-items:start}
.so>div:nth-child(2){margin-top:clamp(1.5rem,5vw,4.5rem)}
/* motion */
.mo>div{display:grid;grid-template-columns:4fr 8fr;gap:clamp(1.25rem,3vw,3rem);align-items:end;padding:2rem 0;border-top:1px solid var(--line)}
.mo>div:first-child{border-top:0;padding-top:0}
.mo h4{font-weight:600;font-size:clamp(1.4rem,2.6vw,2.2rem);letter-spacing:-.03em;line-height:1.15;margin:.5rem 0 .25rem}

/* photos */
.ph{display:grid;grid-template-columns:7fr 5fr;gap:clamp(.75rem,1.6vw,1.5rem)}
.ph figure{overflow:hidden;background:var(--s1);border:1px solid var(--line)}
.ph{align-items:start}
.ph figure{transition:border-color .3s}
.ph figure:hover{border-color:var(--ac)}
.ph img{width:100%;height:auto;object-fit:contain;display:block}
.ph .t.lo{margin-top:clamp(1rem,6vw,6rem)}
.ph figure:nth-child(3){grid-column:1;grid-row:2}
.ph figure:nth-child(2){grid-column:2;grid-row:1}
.ph figure:nth-child(3).t{margin-top:0}
.ph figure:nth-child(4){grid-column:2;grid-row:2}
.ph figure:nth-child(5){grid-column:1;grid-row:3}

/* experience */
.ex>div{display:grid;grid-template-columns:4fr 8fr;gap:1rem 3rem;padding:1.75rem 0;border-top:1px solid var(--line)}
.ex>div:last-child{border-bottom:1px solid var(--line)}
.ex h3{font-weight:500;font-size:clamp(1.15rem,2vw,1.5rem);letter-spacing:-.02em;line-height:1.25}
.ex p{color:var(--mu);max-width:62ch}
.ex .d{font-size:.85rem;color:var(--ac);margin-top:.25rem}

/* skills */
.sk{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem)}
.sk h3{font-weight:500;font-size:.85rem;color:var(--mu);margin-bottom:1.25rem;font-size:.78rem}
.sk ul{list-style:none;display:flex;flex-wrap:wrap;gap:.6rem}
.sk li{border:1px solid var(--line);padding:.45rem .9rem;font-size:.95rem;transition:border-color .3s,color .3s}
.sk li:hover{border-color:var(--ac)}
.sw{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.sw li{list-style:none;border:1px solid var(--line);padding:1rem 1.1rem;font-size:.95rem;background:var(--s1);transition:border-color .3s}
.sw li:hover{border-color:var(--ac)}
.sw .k{grid-column:span 1;background:var(--s2);border-color:#3a3f48;font-size:1.25rem;font-weight:500;letter-spacing:-.02em;padding:2rem 1.1rem}
.sw .k small{display:block;font-size:.78rem;color:var(--ac);font-weight:400;letter-spacing:0;margin-top:.3rem}
.sw ul{display:contents}

/* contact */
.ct{border-top:1px solid var(--line)}
.ct .big{display:inline-block;font-weight:600;font-size:clamp(1.5rem,5.6vw,4.6rem);letter-spacing:-.045em;line-height:1.05;margin:1.5rem 0 2.5rem;overflow-wrap:anywhere}
.ct .big .ul-in{background:linear-gradient(var(--ac),var(--ac)) 0 100%/0 2px no-repeat;transition:background-size .4s}
.ct .big:hover .ul-in{background-size:100% 2px}
.ct .row{display:flex;flex-wrap:wrap;gap:1.25rem 3.5rem;align-items:center;justify-content:space-between}
.ct .info{display:flex;flex-wrap:wrap;gap:.5rem 3rem}
.ct .info span,.ct .info a{display:block}
.btn{display:inline-block;border:1px solid var(--ac);color:var(--ac);padding:.85rem 1.6rem;font-weight:500;transition:background .3s,color .3s}
.btn:hover{background:var(--ac);color:var(--bg)}

/* reveal */
.rv{opacity:0;transform:translateY(18px);transition:opacity .8s,transform .8s cubic-bezier(.2,.7,.2,1)}
.rv.in{opacity:1;transform:none}

@media(max-width:900px){
 .bc>.a,.bc>.a+.cap-side,.bc>.b{grid-column:1/-1}
 .bc>.b{grid-column:span 6}
 .ev>div:last-child{margin-top:0}
 .mo>div,.ex>div{grid-template-columns:1fr}
 .sk{grid-template-columns:1fr}
}
@media(max-width:640px){
 nav ul{gap:1.1rem}nav li:nth-child(2),nav li:nth-child(4){display:none}
 .bc>.b,.ev{grid-template-columns:1fr;grid-column:1/-1}
 .so{grid-template-columns:1fr;max-width:320px;margin:0 auto;gap:2.5rem}
 .so>div:nth-child(2){margin-top:0}
 .ph{grid-template-columns:1fr}
 .ph figure{grid-column:1!important;grid-row:auto!important;margin-top:0!important}
 .role div:last-child{text-align:left}
 .sh .lab,.cat header .lab{display:none}
 .sw{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){
 html{scroll-behavior:auto}
 *{animation:none!important;transition:none!important}
 .rv{opacity:1;transform:none}
}
</style>
</head>
